{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/pptx-design-quality/template-profile-schema.json",
  "title": "Presentation template profile",
  "type": "object",
  "required": ["contract_version", "template", "brand", "geometry", "typography", "composition", "archetypes"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "template": {
      "type": "object",
      "required": ["id", "source", "aspect_ratio", "output_mode"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": ["string", "null"]},
        "aspect_ratio": {"enum": ["16:9", "4:3", "custom"]},
        "output_mode": {"enum": ["native", "hybrid", "image-per-slide"]}
      },
      "additionalProperties": false
    },
    "brand": {
      "type": "object",
      "required": ["colors", "heading_font", "body_font", "logo_policy", "image_treatment", "icon_style"],
      "properties": {
        "colors": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}},
        "heading_font": {"type": "string", "minLength": 1},
        "body_font": {"type": "string", "minLength": 1},
        "logo_policy": {"type": "string", "minLength": 1},
        "image_treatment": {"type": "string", "minLength": 1},
        "icon_style": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "required": ["safe_margin_inches", "title_zone_inches", "footer_zone_inches", "grid_columns", "gutter_inches"],
      "properties": {
        "safe_margin_inches": {"type": "number", "minimum": 0},
        "title_zone_inches": {"type": "number", "exclusiveMinimum": 0},
        "footer_zone_inches": {"type": "number", "minimum": 0},
        "grid_columns": {"type": "integer", "minimum": 1},
        "gutter_inches": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "typography": {
      "type": "object",
      "required": ["title_pt", "body_pt", "caption_pt", "metric_pt", "max_font_families"],
      "properties": {
        "title_pt": {"type": "number", "minimum": 18},
        "body_pt": {"type": "number", "minimum": 8},
        "caption_pt": {"type": "number", "minimum": 6},
        "metric_pt": {"type": "number", "minimum": 18},
        "max_font_families": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "composition": {
      "type": "object",
      "required": ["density", "corner_radius", "shadow_policy", "accent_policy", "whitespace_policy"],
      "properties": {
        "density": {"enum": ["sparse", "executive-medium", "analytical-dense"]},
        "corner_radius": {"type": "number", "minimum": 0},
        "shadow_policy": {"type": "string", "minLength": 1},
        "accent_policy": {"type": "string", "minLength": 1},
        "whitespace_policy": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "archetypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
    }
  },
  "additionalProperties": false
}
