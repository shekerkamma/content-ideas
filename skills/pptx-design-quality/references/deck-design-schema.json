{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/pptx-design-quality/deck-design-schema.json",
  "title": "PPTX deck design quality contract",
  "type": "object",
  "required": ["contract_version", "deck", "typography", "color", "layout", "qa"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "deck": {
      "type": "object",
      "required": [
        "name",
        "design_mode",
        "output_mode",
        "reference_design",
        "anti_references"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "design_mode": {
          "enum": ["brand", "corporate", "editorial", "technical", "product"]
        },
        "output_mode": {"enum": ["native", "hybrid", "image-per-slide"]},
        "reference_design": {"type": ["string", "null"]},
        "anti_references": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "typography": {
      "type": "object",
      "required": [
        "heading_fonts",
        "body_fonts",
        "min_body_font_pt",
        "min_caption_font_pt",
        "max_font_families"
      ],
      "properties": {
        "heading_fonts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "body_fonts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "min_body_font_pt": {"type": "number", "minimum": 8},
        "min_caption_font_pt": {"type": "number", "minimum": 6},
        "max_font_families": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "color": {
      "type": "object",
      "required": ["max_distinct_colors", "min_contrast_ratio"],
      "properties": {
        "max_distinct_colors": {"type": "integer", "minimum": 1},
        "min_contrast_ratio": {"type": "number", "minimum": 1, "maximum": 21}
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "required": [
        "aspect_ratio",
        "grid_columns",
        "max_words_per_slide",
        "max_shapes_per_slide",
        "max_consecutive_same_archetype",
        "min_image_dpi"
      ],
      "properties": {
        "aspect_ratio": {"enum": ["16:9", "4:3", "custom"]},
        "grid_columns": {"type": "integer", "minimum": 1},
        "max_words_per_slide": {"type": "integer", "minimum": 10},
        "max_shapes_per_slide": {"type": "integer", "minimum": 1},
        "max_consecutive_same_archetype": {"type": "integer", "minimum": 1},
        "min_image_dpi": {"type": "number", "minimum": 36}
      },
      "additionalProperties": false
    },
    "qa": {
      "type": "object",
      "required": ["ignore_rules", "waivers"],
      "properties": {
        "ignore_rules": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "uniqueItems": true
        },
        "waivers": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1, "pattern": "\\S"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
