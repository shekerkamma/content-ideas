{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/pptx-visual-spec/slide-plan-schema.json",
  "title": "Presentation semantic slide plan",
  "type": "object",
  "required": ["contract_version", "deck", "claims", "slides"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "deck": {
      "type": "object",
      "required": ["name", "evidence_contract", "visual_contract"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "evidence_contract": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Path to presentation-evidence.json, or null for a greenfield deck with no source evidence contract."
        },
        "visual_contract": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/slide"}
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": ["id", "text", "kind", "confidence", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "kind": {"enum": ["fact", "metric", "interpretation", "recommendation"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "slide": {
      "type": "object",
      "required": [
        "slide_id",
        "archetype",
        "action_title",
        "audience_job",
        "claim_ids",
        "evidence_ids",
        "visual_ids",
        "speaker_notes",
        "accessibility",
        "status"
      ],
      "properties": {
        "slide_id": {"type": "integer", "minimum": 1},
        "archetype": {"type": "string", "minLength": 1},
        "action_title": {"type": "string", "minLength": 1},
        "audience_job": {"type": "string", "minLength": 1},
        "claim_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "visual_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "speaker_notes": {
          "type": "object",
          "required": ["talk_time_seconds", "narrative", "demo_fallback"],
          "properties": {
            "talk_time_seconds": {"type": ["integer", "null"], "minimum": 0},
            "narrative": {"type": ["string", "null"]},
            "demo_fallback": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "accessibility": {
          "type": "object",
          "required": ["reading_order", "visual_alt_text"],
          "properties": {
            "reading_order": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "visual_alt_text": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "status": {"enum": ["planned", "built", "reviewed", "omitted"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
