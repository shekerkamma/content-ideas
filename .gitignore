


# Build output
dist/
.next/
out/
node_modules/
tsconfig.tsbuildinfo

# Python
__pycache__/
*.pyc
*.pyo

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
playwright-report/
test-results/
domain-workflows/**/out/

# Secrets (credentials normally live in ~/.config/content/.env, never the repo)
.env
.env.*
.claude/settings.local.json

# Runtime / dev artifacts
scrape_err.log
*.log

# Feed output (normally written under $CONTENT_HOME, ignored here as a safety net)
for-you.html
feed-data.json
feedback.json

# OS
.DS_Store
node_modules

# Office lock files (created when a .pptx/.docx/.xlsx is opened from Windows)
~$*.pptx
~$*.docx
~$*.xlsx

# Run-folder QA renders and raw search payloads are reproducible from the
# builders and the research scripts; commit the contracts, notes and the
# reviewed deck instead (see runs/*/v7-native/BOUND-DECK-NOTES.md).
runs/**/qa/renders*/
runs/**/qa/*.png
runs/**/research/raw/
runs/**/*-draft.pptx
runs/**/*.pptx.inspect.ndjson
