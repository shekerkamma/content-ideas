    {
      "label": "4-Week Pilot Delivery Structure",
      "file_type": "rationale",
      "source_file": "brainstorms/2026-06-05-predictive-quality-realization.md",
      "source_location": "line 59",
      "source_url": null,
      "captured_at": "2026-06-05",
      "author": null,
      "contributor": null,
      "rationale": "4-week pilot: Week 1 data discovery, Week 2 feature engineering + baseline, Week 3 dashboard + SAP integration, Week 4 shadow-mode validation. Aggressive but achievable for single-station pilot. OpenHands cuts from 8-12 weeks traditional.",
      "id": "brainstorms_2026_06_05_predictive_quality_realization_four_week_pilot",
      "community": 5,
      "norm_label": "4-week pilot delivery structure"
    },
    {
      "label": "Pricing Model ($40-60K pilot, $8-12K/month retainer)",
      "file_type": "rationale",
      "source_file": "brainstorms/2026-06-05-predictive-quality-realization.md",
      "source_location": "line 64",
      "source_url": null,
      "captured_at": "2026-06-05",
      "author": null,
      "contributor": null,
      "rationale": "Fixed $40-60K pilot fee (50-70% cheaper than traditional consulting at $120-180K). $8-12K/month retainer for monitoring, retraining, support. $20K per additional production line. Value anchor is prevented scrap cost.",
      "id": "brainstorms_2026_06_05_predictive_quality_realization_pricing_model",
      "community": 5,
      "norm_label": "pricing model ($40-60k pilot, $8-12k/month retainer)"
    },
    {
      "label": "Week 1 Data Discovery Gate (Risk Mitigation)",
      "file_type": "rationale",
      "source_file": "brainstorms/2026-06-05-predictive-quality-realization.md",
      "source_location": "line 69",
      "source_url": null,
      "captured_at": "2026-06-05",
      "author": null,
      "contributor": null,
      "rationale": "Data quality is risk #1. Week 1 is entirely data discovery \u2014 if data is unusable, pivot scope or exit before spending model-build effort. This is the kill gate for the engagement.",
