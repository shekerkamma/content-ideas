{
  "version": 1,
  "brand": "{{brand_name}}",
  "palette": {
    "primary": {
      "hex": "#0F172A",
      "name": "Slate 900",
      "usage": "Headers, primary backgrounds, hero sections"
    },
    "secondary": {
      "hex": "#1E293B",
      "name": "Slate 800",
      "usage": "Cards, panels, secondary backgrounds"
    },
    "accent": {
      "hex": "#22D3EE",
      "name": "Cyan 400",
      "usage": "CTAs, links, highlights, code accents, emphasis"
    },
    "background": {
      "hex": "#F8FAFC",
      "name": "Slate 50",
      "usage": "Page backgrounds, light mode base"
    },
    "text": {
      "hex": "#0F172A",
      "name": "Slate 900",
      "usage": "Body text on light backgrounds"
    },
    "surface": {
      "hex": "#F1F5F9",
      "name": "Slate 100",
      "usage": "Card backgrounds, code blocks, inset panels"
    },
    "muted": {
      "hex": "#94A3B8",
      "name": "Slate 400",
      "usage": "Secondary text, borders, captions, timestamps"
    },
    "text_on_dark": {
      "hex": "#F8FAFC",
      "name": "Slate 50",
      "usage": "Text on dark primary/secondary backgrounds"
    },
    "success": {
      "hex": "#10B981",
      "name": "Emerald 500",
      "usage": "Success states, positive indicators, terminal green"
    }
  },
  "typography": {
    "display": {
      "family": "Inter Tight",
      "weights": ["Bold", "ExtraBold", "Black"],
      "fallback": "'Inter', 'Helvetica Neue', sans-serif",
      "usage": "Headings, titles, hero text, slide numerals, brand name"
    },
    "body": {
      "family": "Inter",
      "weights": ["Regular", "Medium", "Bold"],
      "fallback": "'Helvetica Neue', Arial, sans-serif",
      "usage": "Paragraphs, captions, UI text, code comments"
    },
    "mono": {
      "family": "JetBrains Mono",
      "weights": ["Regular", "Bold"],
      "fallback": "'Fira Code', 'Consolas', monospace",
      "usage": "Code snippets, terminal output, technical callouts"
    }
  },
  "spacing": {
    "canvas_padding": 80,
    "block_padding_v": 50,
    "block_padding_h": 40,
    "scale": {
      "2xs": 4,
      "xs": 8,
      "sm": 12,
      "md": 16,
      "lg": 24,
      "xl": 32,
      "2xl": 48,
      "3xl": 64,
      "4xl": 96,
      "5xl": 128
    }
  },
  "chrome": {
    "masthead": {
      "enabled": true,
      "labels": ["{{month_year}}", "{{handle}}", "{{tagline}}"]
    },
    "pagination": {
      "subtype": "css-shape",
      "count": 7,
      "active": 1
    }
  },
  "logo": {
    "logomark": null,
    "logotype": null,
    "lockup": null,
    "clear_space": "1x logo height",
    "min_size": "24px"
  },
  "locked_fields": ["brand", "chrome.masthead"]
}
