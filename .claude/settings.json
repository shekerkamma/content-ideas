{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Read(./secrets/**)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)"
    ]
  },
  "skillListingBudgetFraction": 0.1,
  "extraKnownMarketplaces": {
    "content-ideas": {
      "source": {
        "source": "github",
        "repo": "shekerkamma/content-ideas"
      }
    }
  },
  "enabledPlugins": {
    "content-ideas@content-ideas": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/link-cloud-skills.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-tests.sh",
            "timeout": 300,
            "statusMessage": "Running tests for changed files"
          }
        ]
      }
    ]
  }
}
