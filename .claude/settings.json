{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "content-ideas": {
      "source": {
        "source": "github",
        "repo": "shekerkamma/content-ideas"
      }
    }
  },
  "enabledPlugins": {
    "content-ideas@content-ideas": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/link-cloud-skills.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
