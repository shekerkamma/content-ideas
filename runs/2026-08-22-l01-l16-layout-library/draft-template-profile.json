{
  "contract_version": "1.0",
  "template": {
    "id": "client-executive",
    "source": "runs/2026-08-22-l01-l16-layout-library/canvas",
    "aspect_ratio": "16:9",
    "output_mode": "native"
  },
  "brand": {
    "colors": {
      "page": "#FFFFFF",
      "ink": "#0A1628",
      "accent": "#00B4D8"
    },
    "heading_font": "Georgia",
    "body_font": "Aptos",
    "logo_policy": "Use only supplied approved marks in the configured safe zone",
    "image_treatment": "Use purposeful crops with consistent edge treatment",
    "icon_style": "Use one restrained line-icon family"
  },
  "geometry": {
    "safe_margin_inches": 0.5,
    "title_zone_inches": 1.1,
    "footer_zone_inches": 0.35,
    "grid_columns": 12,
    "gutter_inches": 0.167
  },
  "typography": {
    "title_pt": 30.0,
    "body_pt": 13.5,
    "caption_pt": 7.5,
    "metric_pt": 34,
    "max_font_families": 2
  },
  "composition": {
    "density": "executive-medium",
    "corner_radius": 0.083,
    "shadow_policy": "Use only when it communicates foreground hierarchy",
    "accent_policy": "Use one primary accent for decisions and emphasis",
    "whitespace_policy": "Preserve clear separation between message, evidence, and implication"
  },
  "archetypes": [
    "big-number",
    "comparison",
    "cover",
    "decision-scorecard",
    "executive-summary",
    "operating-model",
    "recommendation-ask",
    "risk-mitigation",
    "roadmap",
    "section-divider",
    "three-card-argument"
  ]
}
