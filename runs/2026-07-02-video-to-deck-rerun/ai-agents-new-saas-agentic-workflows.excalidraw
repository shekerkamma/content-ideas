      "roundness": null,
      "seed": 48680,
      "version": 1,
      "versionNonce": 620222,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782981769868,
      "link": null,
      "locked": false,
      "text": "Unlike individual agents, workflows are predefined and static. Two common patterns are sequential and hierarchical.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 23,
      "originalText": "Unlike individual agents, workflows are predefined and static. Two common patterns are sequential and hierarchical.",
      "autoResize": true,
      "lineHeight": 1.25
    },
