      "isDeleted": false,
      "boundElements": null,
      "updated": 1782981769868,
      "link": null,
      "locked": false,
      "text": "Agentic workflows define the structure of how agents operate, communicate, hand off tasks, and collaborate toward shared objectives.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 24,
      "originalText": "Agentic workflows define the structure of how agents operate, communicate, hand off tasks, and collaborate toward shared objectives.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "text_80",
      "type": "text",
      "x": 80,
      "y": 208,
      "width": 940,
      "height": 56,
      "angle": 0,
      "strokeColor": "#cfd4da",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
