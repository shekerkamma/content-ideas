{
  "site": "https://example.invalid/fixture/",
  "published": "published",
  "rebuilt": "rebuilt",
  "build_env": ["VITE_RERANK_ENDPOINT"],
  "artifacts": [
    {"role": "app-bundle", "published": "assets/index-*.js", "expect": "identical"},
    {"role": "stylesheet", "published": "assets/index-*.css", "expect": "identical"},
    {"role": "retrieval-index", "published": "assets/knowledge-index-*.js",
     "expect": "explained", "max_differing_bytes": 32,
     "reason": "the index generator embeds its own build timestamp"},
    {"role": "worker", "published": "assets/never-emitted-*.js", "expect": "identical"},
    {"role": "legend", "published": "assets/legend.js", "rebuilt": "assets/legend.js",
     "expect": "explained", "reason": ""},
    {"role": "pinned-name", "published": "assets/index-Czj8W0QI.css", "expect": "identical"}
  ]
}
