        </mxCell>
        <mxCell id="subtitle" value="One operator + a control-plane agent that builds &amp; manages per-client agents. Sell a digital employee, not an agent. $5K&#8211;$10K / client / month." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
